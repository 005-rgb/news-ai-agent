# ─────────────────────────────────────────────────────────────────────────────
# .env.cpanel.example
#
# Salin nilai-nilai ini ke cPanel > Node.js Selector > Environment Variables
# JANGAN letakkan file .env di server — gunakan UI cPanel.
# ─────────────────────────────────────────────────────────────────────────────

# [WAJIB] PostgreSQL connection string (sesuaikan password & db name)
DATABASE_URL=postgresql://smknwon2_agentic_user:PASSWORD@localhost:5432/smknwon2_agentic_db

# [WAJIB] Session secret — string acak panjang (min 32 karakter)
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang

# [WAJIB] AES-256 encryption key — 64 karakter hex
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=ganti-dengan-64-karakter-hex

# [WAJIB] Mode production
NODE_ENV=production

# [OPSIONAL] Port — cPanel/Passenger biasanya set otomatis via PORT env var
# PORT=5000

# [OPSIONAL] Admin credentials
ADMIN_USERNAME=admin
# Generate hash: node -e "require('bcryptjs').hash('passwordkamu', 12).then(h => console.log(h))"
ADMIN_PASSWORD_HASH=$2a$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [OPSIONAL] Timezone
TIMEZONE=Asia/Jakarta

# [OPSIONAL] CORS origins (domain produksi)
CORS_ORIGINS=https://nh.jobenapp.cloud

# [OPSIONAL] API Keys eksternal (diisi via dashboard setelah deploy)
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
